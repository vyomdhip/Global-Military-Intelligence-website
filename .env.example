# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/gmi?retryWrites=true&w=majority

# JWT signing secret — change this to any random string
JWT_SECRET=your_jwt_secret_here

# Admin credentials (created on first server start)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_password_here
ADMIN_EMAIL=admin@example.com

# Server port
PORT=3000

# Maintenance Mode (set to true to enable)
MAINTENANCE_MODE=false
MAINTENANCE_MESSAGE=We are performing scheduled system upgrades to improve platform performance and security.
MAINTENANCE_ETA=
